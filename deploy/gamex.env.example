# Copy the lines you need into /etc/gamex.env on the VPS, then run
#   systemctl restart gamex
# Every service below is optional. Without its keys the feature runs in a
# safe demo mode. Never commit real keys to git.

# ── SMS OTP login (pick one) ─────────────────────────────────────────────
# MSG91 (India, DLT-approved OTP template with ##OTP## variable)
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# Twilio
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_FROM=+1xxxxxxxxxx
# Testing only: shows the OTP inside the app. Never enable in production.
# OTP_DEV_MODE=1

# ── Payments: Razorpay (UPI, cards, wallets, EMI) ───────────────────────
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
# RAZORPAY_KEY_SECRET=
# Webhook secret (Razorpay → Webhooks, URL …/gamex/api/payments/razorpay/webhook,
# events refund.processed, refund.failed, payment.captured)
# RAZORPAY_WEBHOOK_SECRET=

# ── Database ────────────────────────────────────────────────────────────
# Set automatically by remote-setup.sh (PostgreSQL). Without it the server
# uses data/db.json (local development only).
# DATABASE_URL=postgres://gamex:<password>@127.0.0.1:5432/gamex

# ── Push notifications: Firebase Cloud Messaging ────────────────────────
# Path to the service-account JSON downloaded from Firebase console →
# Project settings → Service accounts → Generate new private key.
# FCM_SERVICE_ACCOUNT=/etc/gamex-fcm.json

# ── Courier: Shiprocket (real AWB, pickup and live tracking) ────────────
# SHIPROCKET_EMAIL=
# SHIPROCKET_PASSWORD=
# SHIPROCKET_PICKUP=Primary

# ── Android App Links (share links open the app directly) ───────────────
# SHA-256 of the app signing certificate, e.g. from
#   keytool -list -v -keystore ~/.android/debug.keystore -alias androiddebugkey -storepass android
# ANDROID_SHA256=AA:BB:CC:...
